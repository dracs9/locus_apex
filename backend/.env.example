# Postgres connection string (Supabase > Project Settings > Database). Use the asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
# Legacy HS256 JWT secret. Leave empty if your project uses asymmetric signing keys (JWKS is used then).
SUPABASE_JWT_SECRET=
# Gemini API key. Leave empty to run with template fallbacks only.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
